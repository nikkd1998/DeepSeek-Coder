{
    "bf16": {
        "enabled": "auto"
    },
    "optimizer": {
        "type": "AdamW",
        "params": {
            "lr": "auto",
            "betas": "auto",
            "eps": "auto",
            "weight_decay": "semiauto"
        }
    },

    "scheduler": {
        "type": "WarmupLR",
        "params": {
            "warmup_min_lr": "semiauto",
            "warmup_max_lr": "semiauto",
            "warmup_num_steps": "semiauto"
        }
    },

    "zero_optimization": {
        "stage": 3,
        "offload_optimizer": {
            "device": "cpu",
            "pin_memory": true
        },
        "offload_param": {
            "device": "cpu",
            "pin_memory": true
        },
        "overlap_comm": true,
        "contiguous_gradients": true,
        "sub_group_size": 1e9,
        "reduce_bucket_size": "semiauto",
        "stage3_prefetch_bucket_size": "semiauto",
        "stage3_param_persistence_threshold": "semiauto",
        "stage3_max_live_parameters": 1e9,
        "stage3_max_reuse_distance": 1e9,
        "stage3_gather_16bit_weights_on_model_save": true
    },

    "gradient_accumulation_steps": "semiauto",
    "gradient_clipping": "semiauto",
    "steps_per_print": 20,
    "train_batch_size": "semiauto",
    "train_micro_batch_size_per_gpu": "semiauto",
    "wall_clock_breakdown": true,
}
